[Unit]
Description=Linux Infrastructure Automation Lab configuration backup
Documentation=urn:linux-infrastructure-automation-lab:configuration-backup
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/lab-config-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/linux-infrastructure
ReadOnlyPaths=/etc/nginx /etc/ssh /etc/ufw
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
