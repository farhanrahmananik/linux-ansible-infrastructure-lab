#!/usr/bin/env bash
set -euo pipefail

backup_dir="/var/backups/linux-infrastructure"
archive="${backup_dir}/config-backup.tar.gz"
tmp_dir=""
result=""

cleanup() {
  if [[ -n "${tmp_dir}" && -d "${tmp_dir}" ]]; then
    rm -rf -- "${tmp_dir}"
  fi
}
trap cleanup EXIT INT TERM

tmp_dir="$(mktemp -d "${backup_dir}/.lab-config-backup.XXXXXX")"
tmp_archive="${tmp_dir}/config-backup.tar.gz"

tar   --sort=name   --mtime="UTC 1970-01-01"   --owner=0   --group=0   --numeric-owner   --pax-option="delete=atime,delete=ctime"   -C /   -cf -   etc/nginx   etc/ssh/sshd_config   etc/ssh/sshd_config.d   etc/ufw   | gzip -n > "${tmp_archive}"

chmod 0640 "${tmp_archive}"
chown root:root "${tmp_archive}"

if [[ -f "${archive}" ]] && cmp -s "${tmp_archive}" "${archive}"; then
  result="BACKUP_UNCHANGED"
else
  install -o root -g root -m 0640 "${tmp_archive}" "${archive}"
  result="BACKUP_UPDATED"
fi

logger -t lab-config-backup "${result}"
printf '%s
' "${result}"
